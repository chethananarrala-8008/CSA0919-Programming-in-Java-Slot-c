PERFECT NUMBER USING SINGLE INHERITANCE:
class Number {
    int n = 28;
}
class Perfect extends Number {
    void checkPerfect() {
        int sum = 0;

        for (int i = 1; i < n; i++) {
            if (n % i == 0) {
                sum = sum + i;
            }
        }

        if (sum == n) {
            System.out.println(n + " is a Perfect Number");
        } else {
            System.out.println(n + " is Not a Perfect Number");
        }
    }
}
public class Main {
    public static void main(String[] args) {
        Perfect obj = new Perfect();
        obj.checkPerfect();
    }
}
ARMSTRONG NUMBER USING SINGLE INHERITANCE:
class Number {
    int n = 153;
}

class Armstrong extends Number {
    void checkArmstrong() {
        int temp = n;
        int sum = 0;
        int rem;

        while (temp != 0) {
            rem = temp % 10;
            sum = sum + (rem * rem * rem);
            temp = temp / 10;
        }

        if (sum == n) {
            System.out.println(n + " is an Armstrong Number");
        } else {
            System.out.println(n + " is Not an Armstrong Number");
        }
    }
}

public class Main {
    public static void main(String[] args) {
        Armstrong obj = new Armstrong();
        obj.checkArmstrong();
    }
}
